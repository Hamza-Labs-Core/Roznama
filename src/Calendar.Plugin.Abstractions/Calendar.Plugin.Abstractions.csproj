<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The STABLE SDK contract (SDK-CONTRACT.md). The only shared type boundary between host and plugins.
    Dependencies are deliberately minimal: the BCL plus Microsoft.Extensions.Logging.Abstractions (ILogger)
    and System.Net.Http (HttpClient / HttpRequestMessage). Semver'd independently — see SdkVersion.Current.
  -->
  <PropertyGroup>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Version>1.0.0</Version>
    <Description>Stable plugin SDK contract for Unified Calendar — IPlugin, capability interfaces, manifest types.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
