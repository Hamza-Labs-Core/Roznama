<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Copy NuGet deps (Ical.Net + its closure) into bin so the plugin bundle is self-contained
         and the collectible ALC's dependency resolver can find them. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK contract is supplied by the host (shared ALC boundary), so don't copy it into the bundle. -->
    <ProjectReference Include="..\..\src\Calendar.Plugin.Abstractions\Calendar.Plugin.Abstractions.csproj"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
